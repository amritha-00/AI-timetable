# Base URL for the FastAPI backend. In dev, Vite proxies /api/* to this same
# target (see vite.config.ts), so a relative path works there too - this is
# mainly what a production build (served separately from the API) uses.
VITE_API_URL=http://localhost:8000/api

# Set to "true" to run entirely on the mock data layer (src/lib/api/mocks),
# with no backend required - this is what the "Load demo school" button and
# local UI development both use. Set to "false" once the real backend is
# ready to integrate against.
VITE_USE_MOCKS=true
