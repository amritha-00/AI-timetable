# ===================================================================
# AI School Timetable Generator - Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ===================================================================

# ---------- Database (MySQL via XAMPP) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=timetable_ai
# Full SQLAlchemy URL is assembled from the above in backend/app/config.py,
# but you can override it directly if needed:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/timetable_ai

# ---------- App ----------
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Admin panel (platform owner, not a school tenant) ----------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-admin

# ---------- LLM Provider ----------
# Choose one of: "anthropic" | "bedrock" | "gemini" | "mock"
# "mock" is a deterministic offline stand-in (no API key/cloud creds needed) -
# useful for developing/testing the constraint pipeline without spending API
# credits. It has narrow, regex-based sentence coverage - always benchmark
# real accuracy against "anthropic", "bedrock", or "gemini", never "mock".
LLM_PROVIDER=gemini

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- AWS Bedrock (Amazon Nova) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# --- Google Gemini (free tier - no credit card) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Solver ----------
SOLVER_MAX_SECONDS=30
SOLVER_NUM_WORKERS=8

# ---------- Billing (Stripe) ----------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys - free, no
# card needed. Leave blank to use the mock "upgrade" fallback instead (no
# Stripe account needed for local dev - see backend/app/routers/billing.py).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Dashboard -> Product catalog -> your product -> pricing, e.g. "price_1Abc..."
STRIPE_PRICE_ID=
# From the webhook endpoint's "Signing secret" in the Dashboard, or the
# `stripe listen` CLI command's output when testing webhooks locally.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the tenant back to after checkout - your frontend's
# real origin in production (e.g. https://your-app.vercel.app).
FRONTEND_URL=http://localhost:5173
